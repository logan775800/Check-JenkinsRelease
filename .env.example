# 复制成 .env 再改：cp .env.example .env
# .env 已被 .gitignore 忽略，不会入库。

# Jenkins 地址（必填）
JENKINS_URL=https://your-jenkins-host

# 时区，必须和 Jenkins 服务器一致（必填，否则时间对不上、按天核对还会漏判）。
# 怎么确定：打开任意一次构建页看它显示的时间，和下面这条命令算出的 UTC 时间比，差几小时就是几。
#   curl -s "$JENKINS_URL/job/<任一job>/lastBuild/api/json?tree=timestamp"
# 常见值：Asia/Kolkata(UTC+5:30) / Asia/Shanghai(UTC+8) / UTC
TZ=UTC

# 每个 job 往回翻多少次构建历史。
# 现在是「按需拉」——只拉本次真正要核对的那些 job，所以这个值不再明显影响速度，
# 反倒是调小了有风险：这 N 次要是全都晚于时间窗，窗口内那次就没拿到，会误报「未发布」。
# 核对几天前的发版、或者发完又构建了很多次时，把它调大。工具遇到这种情况会告警。
JENKINS_MAX_BUILDS=30

# 缓存秒数。一次核对往往连点几次，缓存期内不重复打 Jenkins（页面上有「强制刷新」）
JENKINS_CACHE_TTL=60

# 按需拉构建历史时的并发数。Jenkins 前面有 WAF，往上调容易被限速
JENKINS_FETCH_CONCURRENCY=6

# 要拉的 job 超过这个数就改用「一次性全量」那条老路：
# 几百个短请求穿 WAF 比一个大请求更容易被限速，到这个量级两者耗时也差不多了
JENKINS_BULK_THRESHOLD=200

# ---- 凭据模式 ----
# 0 = 每个人在网页上填自己的 Jenkins 用户名 + Token，服务端不保存（默认，推荐）
# 1 = 用下面 JENKINS_USER / JENKINS_API_TOKEN 这份共用凭据，打开网页就能查，不用每次填
#
# 只有自己一个人用、且页面没做访问控制时要想清楚：设成 1 的话，
# 任何知道这个网址的人打开就直接以你的身份查 Jenkins。
# 设成 0 则陌生人虽然能打开页面，但没有有效 Token 什么也查不到。
JENKINS_ALLOW_SERVER_CREDS=0
# JENKINS_USER=你的登录名
# JENKINS_API_TOKEN=你的token

# Jenkins 用自签证书时打开
# JENKINS_SKIP_CERT=1

# ---- 后台(Admin)：第二套 Jenkins ----
# 后台不在 AR 那套 Jenkins 上，是独立的一台（Windows），job 名、参数名、凭据都不一样。
# 这四项配齐才启用；不配的话发布单里的「admin → xxx」还是照旧提示「不在这套 Jenkins」，
# 不影响其余核对。
# 凭据要用**那台 Jenkins 上的账号**，不要填 AR 那套的（两边权限没关系）。
# ADMIN_JENKINS_URL=https://后台jenkins地址
# ADMIN_JENKINS_USER=登录名
# ADMIN_JENKINS_TOKEN=在那台的 /me/security/ 生成
# 要核对哪几个 job，逗号分隔。**留空即可** —— 留空会自动去那台 Jenkins 上列全部 job。
# 只有当那台上混着一堆无关 job、结果太吵时，才用它收窄范围。
# ADMIN_JENKINS_JOBS=Sit-Admin,sit-admin-非saas彩票
