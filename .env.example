# 复制成 .env 再改：cp .env.example .env
# .env 已被 .gitignore 忽略，不会入库。

# Jenkins 地址（必填）
JENKINS_URL=https://your-jenkins-host

# 时区，必须和 Jenkins 服务器一致（必填，否则时间对不上、按天核对还会漏判）。
# 怎么确定：打开任意一次构建页看它显示的时间，和下面这条命令算出的 UTC 时间比，差几小时就是几。
#   curl -s "$JENKINS_URL/job/<任一job>/lastBuild/api/json?tree=timestamp"
# 常见值：Asia/Kolkata(UTC+5:30) / Asia/Shanghai(UTC+8) / UTC
TZ=UTC

# 每个 job 往回翻多少次构建历史。job 多、查询慢的话调小，10 也够日常用
JENKINS_MAX_BUILDS=30

# ---- 凭据模式 ----
# 0 = 每个人在网页上填自己的 Jenkins 用户名 + Token，服务端不保存（默认，推荐）
# 1 = 用下面 JENKINS_USER / JENKINS_API_TOKEN 这份共用凭据，打开网页就能查，不用每次填
#
# 只有自己一个人用、且页面没做访问控制时要想清楚：设成 1 的话，
# 任何知道这个网址的人打开就直接以你的身份查 Jenkins。
# 设成 0 则陌生人虽然能打开页面，但没有有效 Token 什么也查不到。
JENKINS_ALLOW_SERVER_CREDS=0
# JENKINS_USER=你的登录名
# JENKINS_API_TOKEN=你的token

# Jenkins 用自签证书时打开
# JENKINS_SKIP_CERT=1
