[Unit]
Description=Jenkins Release Check (web)
Documentation=https://github.com/logan775800/Check-JenkinsRelease
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jenkinscheck
Group=jenkinscheck
WorkingDirectory=/opt/check-jenkins-release
EnvironmentFile=/etc/check-jenkins-release.env
ExecStart=/usr/bin/python3 /opt/check-jenkins-release/app.py
Restart=always
RestartSec=3

# 只读服务，不需要任何写权限，全部收紧
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadOnlyDirectories=/opt/check-jenkins-release

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jenkins-check

[Install]
WantedBy=multi-user.target
